# 3. 인구 격자 경계 + 인구 통계 병합
# =========================================================
grid_gdf = gpd.read_file(GRID_BOUNDARY_PATH)  # encoding 지정 없이 (깨지면 encoding='euc-kr' 시도)
print(f"[확인] 격자 경계 좌표계: {grid_gdf.crs}")
