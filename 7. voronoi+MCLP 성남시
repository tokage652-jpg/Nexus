                         "최적화된 배치", coverage_final)
plot_coverage(axes[1, 0], points, pop_xy, pop_values, RADIUS_KM, boundary_polys,
              "현재 실제 배치", coverage_current)
plot_coverage(axes[1, 1], final_points, pop_xy, pop_values, RADIUS_KM, boundary_polys,
